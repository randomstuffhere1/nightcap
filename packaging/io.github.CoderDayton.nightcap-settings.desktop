# Modified by vii from komaruworld/mocktail. See README "About this fork".
# A second entry so the settings window is reachable from the app menu without a
# terminal. It opens the same window as `mocktail --settings`, and like that
# flag it does not start Roblox. Kept in its own file because a desktop entry
# holds exactly one [Desktop Entry] group.
[Desktop Entry]
Type=Application
Name=Nightcap Settings
GenericName=Nightcap Configuration
Comment=Configure Nightcap
Exec=env SDL_VIDEODRIVER=wayland,x11 mocktail --settings
Icon=io.github.CoderDayton.nightcap
StartupWMClass=io.github.CoderDayton.nightcap
Categories=Game;
Terminal=false
X-Mocktail-Managed=true
